# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
-keep class net.extrawdw.apps.miuisucks.powerkeeper.PowerKeeperUserService { *; }
-keep class net.extrawdw.apps.miuisucks.powerkeeper.IPrivilegedService { *; }
-keep class net.extrawdw.apps.miuisucks.powerkeeper.IPrivilegedService$Stub { *; }
-keep class net.extrawdw.apps.miuisucks.powerkeeper.IEnforcementProgressCallback { *; }
-keep class net.extrawdw.apps.miuisucks.powerkeeper.IEnforcementProgressCallback$Stub { *; }

# Android Navigation 3 saves NavKey class names and restores them with Class.forName.
# Keep the destination name stable across optimized builds; kotlinx.serialization's
# bundled consumer rules retain the companion's serializer lookup members.
-keepnames class net.extrawdw.apps.miuisucks.powerkeeper.GuardTab
